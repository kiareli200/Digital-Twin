# Copia este archivo como .env y completa solo lo que uses. Todo es opcional.

# Rutas (por defecto: ./data, ./gemelo_config.json, ./users.json)
GEMELO_DATA_DIR=./data
GEMELO_CONFIG=./gemelo_config.json
GEMELO_USERS=./users.json
GEMELO_LOG_LEVEL=INFO

# Aviso por correo cuando el gemelo propone una intervención
GEMELO_SMTP_HOST=smtp.ejemplo.com
GEMELO_SMTP_PORT=587
GEMELO_SMTP_USER=gemelo@ejemplo.com
GEMELO_SMTP_PASSWORD=
GEMELO_MAIL_FROM=gemelo@ejemplo.com
GEMELO_MAIL_TO=jefe.mantenimiento@ejemplo.com,supervisor@ejemplo.com

# Aviso por webhook (Teams, Slack u otro que acepte {"text": "..."})
GEMELO_WEBHOOK_URL=
